{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Reverse Clip",
  "nameJa": "動画逆再生",
  "slug": "reverse-clip",
  "version": "0.1.7",
  "description": "Experimental reverse MP4 ST/MT with 360/720px long-edge presets and a guarded native 720p-class 5-second output pilot.",
  "descriptionJa": "ST/MT両版で逆再生MP4を作る実験版。従来の長辺360/720pxに加えて、標準720p級の最大5秒出力を試験的に追加しました。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-reverse-clip"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html",
      "multiThreadOutput": "dist/index.mt.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    },
    "multiThreadOutput": "dist/index.mt.html"
  }
}
