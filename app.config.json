{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Reverse Clip",
  "nameJa": "動画逆再生",
  "slug": "reverse-clip",
  "version": "0.3.0",
  "description": "Reverse Clip v0.3.0 Trim & Reverse: touch/keyboard range handles and selected-source playback; experimental browser-local ST/MT MP4 reversal.",
  "descriptionJa": "Reverse Clip v0.3.0「区間指定と逆再生」。開始・終了ハンドルと区間プレビュー、ST/MTのローカル逆再生MP4生成を開発中。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-reverse-clip"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html",
      "multiThreadOutput": "dist/index.mt.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    },
    "multiThreadOutput": "dist/index.mt.html"
  }
}
