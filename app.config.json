{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Reverse Clip",
  "nameJa": "動画逆再生",
  "slug": "reverse-clip",
  "version": "0.1.0",
  "description": "Feasibility test for short, fully local video reversal; MP4 export is not yet implemented.",
  "descriptionJa": "短い動画の逆再生をブラウザ内で検証する技術テスト版です。MP4書き出しは未実装です。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-reverse-clip"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    }
  }
}
