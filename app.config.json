{
  "$schema": "./schemas/app-config.schema.json",
  "name": "Reverse Clip",
  "nameJa": "動画逆再生",
  "slug": "reverse-clip",
  "version": "0.5.0",
  "description": "Reverse Clip v0.5.0 audio-mode development; proven ST/MT reverse and ping-pong MP4 remain silent until actual AAC mux and playback pass.",
  "descriptionJa": "Reverse Clip v0.5.0 音声対応の開発段階。ST/MTの逆再生・往復再生は動作しますが、AAC音声の結合検証が終わるまで音声なしを維持します。",
  "defaultLanguage": "auto",
  "repository": {
    "owner": "ttomohisa",
    "name": "htmlapps-reverse-clip"
  },
  "build": {
    "output": "dist/index.html",
    "blockRuntimeNetwork": true,
    "selfExtract": {
      "enabled": true,
      "output": "dist/index.self-extract.html",
      "multiThreadOutput": "dist/index.mt.self-extract.html"
    },
    "sizeBudget": {
      "readableWarningMb": 25,
      "selfExtractWarningMb": 12
    },
    "multiThreadOutput": "dist/index.mt.html"
  }
}
